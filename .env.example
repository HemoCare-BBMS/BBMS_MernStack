# Backend environment variables — copy to .env and fill in real values
PORT=8080
DEV_MODE=development
MONGO_URL=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<db_name>?retryWrites=true&w=majority
JWT_SECRET=<long_random_secret>
# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_URL=http://localhost:3000
